<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive wallet database and credentials from automatic cloud backups -->
        <exclude domain="database" path="decentralnet_db"/>
        <exclude domain="database" path="decentralnet_db-shm"/>
        <exclude domain="database" path="decentralnet_db-wal"/>
        <exclude domain="sharedpref" path="kaspa_node_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <!-- Exclude database and settings from device-to-device transfers to prevent key leakage -->
        <exclude domain="database" path="decentralnet_db"/>
        <exclude domain="database" path="decentralnet_db-shm"/>
        <exclude domain="database" path="decentralnet_db-wal"/>
        <exclude domain="sharedpref" path="kaspa_node_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
