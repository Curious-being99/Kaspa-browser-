# GitHub Linguist Language Overrides
# Configured for KaspaBrowser: Dual-Stack Android Application (Kotlin) + Native JNI Engine (Rust)

# Exclude documentation, assets, and media from language statistics
*.docx linguist-documentation=true
*.md linguist-documentation=true
*.jpg linguist-documentation=true
*.png linguist-documentation=true
*.mp4 linguist-documentation=true
*.gif linguist-documentation=true
*.webm linguist-documentation=true

# Vendor helper scripts & XML/JSON configuration files
*.py linguist-vendored=true
*.sh linguist-vendored=true
*.json linguist-vendored=true
*.xml linguist-vendored=true

# Primary Android Application Layer (Kotlin)
*.kt linguist-language=Kotlin
*.kt linguist-detectable=true
*.kts linguist-language=Kotlin
*.kts linguist-detectable=true

# Native JNI Engine Layer (Rust)
*.rs linguist-language=Rust
*.rs linguist-detectable=true
kaspasearch-engine/** linguist-language=Rust
Cargo.toml linguist-language=Rust
Cargo.toml linguist-detectable=true
